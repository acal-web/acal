// For format details, see https://containers.dev/implementors/json_reference/.
{
  "name": "acal2",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/acal2",
  "remoteUser": "vscode",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // 3000: Rails server (bin/dev). 5432: Postgres, exposed for GUI clients on the host.
  "forwardPorts": [3000, 5432],

  // Installs gems/pub packages and prepares the dev database on first create.
  "postCreateCommand": "cd api && bin/setup --skip-server && cd ../app && flutter pub get",

  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
