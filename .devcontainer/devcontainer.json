// For format details, see https://containers.dev/implementors/json_reference/.
{
  "name": "acal2",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "remoteUser": "vscode",

  "mounts": [
    "source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind",
    "source=${localEnv:HOME}/.ssh/known_hosts,target=/home/vscode/.ssh/known_hosts,type=bind,readonly"
  ],
  "containerEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent"
  },

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/java:1": { "version": "17" }
  },

  // Maestro installs itself to ~/.maestro/bin, which isn't on PATH by default.
  // remoteEnv (not containerEnv) so this only affects VS Code's exec sessions,
  // not the container's own startup command (docker-compose's `sleep infinity`).
  // CHROME_EXECUTABLE: also set in the Dockerfile, repeated here so it applies on
  // "Reload Window" without needing a full container rebuild.
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.maestro/bin",
    "CHROME_EXECUTABLE": "/usr/bin/chromium"
  },

  // 3000: Rails server (bin/dev). 5432: Postgres, exposed for GUI clients on the host.
  // 8080: Flutter web dev server (flutter run -d web-server --web-port 8080), target for Maestro flows.
  "forwardPorts": [3000, 5432, 8080],

  // Installs gems/pub packages, prepares the dev database, and installs the Maestro CLI on first create.
  "postCreateCommand": "cd api && bin/setup --skip-server && cd ../app && flutter pub get && curl -Ls \"https://get.maestro.mobile.dev\" | bash",

  "customizations": {
    "vscode": {
      "settings": {
        "workbench.colorTheme": "Monokai Dimmed",
        "dart.flutterSdkPath": "/opt/flutter"
      },
      "extensions": [
        "Shopify.ruby-lsp",
        "kaiwood.endwise",
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "ms-azuretools.vscode-docker",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "anthropic.claude-code"
      ]
    }
  }
}
