{
  "name": "acal2",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "remoteUser": "vscode",

  "mounts": [
    "source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind",
    "source=${localEnv:HOME}/.ssh/known_hosts,target=/home/vscode/.ssh/known_hosts,type=bind,readonly"
  ],
  "containerEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent"
  },

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1.1.1": {},
    "ghcr.io/devcontainers/features/java:1": { "version": "17" }
  },

  "remoteEnv": {
    "CHROME_EXECUTABLE": "/usr/bin/chromium"
  },

  "forwardPorts": [3000, 5432, 8080],

  "postCreateCommand": "cd api && bin/setup --skip-server && cd ../app && flutter pub get",

  "customizations": {
    "vscode": {
      "settings": {
        "workbench.colorTheme": "Dark Modern",
        "dart.flutterSdkPath": "/opt/flutter",
        "coverage-gutters.watchOnActivate": true,
        "coverage-gutters.coverageBaseDir": "{app,api}/coverage"
      },
      "extensions": [
        "Shopify.ruby-lsp",
        "kaiwood.endwise",
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "ms-azuretools.vscode-docker",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "anthropic.claude-code",
        "ryanluker.vscode-coverage-gutters"
      ]
    }
  }
}
