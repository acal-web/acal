{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/flutter/analyze.sh\"",
            "timeout": 60,
            "statusMessage": "Running flutter analyze..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/rails/rubocop.sh\"",
            "timeout": 60,
            "statusMessage": "Running rubocop..."
          }
        ]
      }
    ]
  }
}
