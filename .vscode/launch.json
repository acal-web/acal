{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "run app",
      "request": "launch",
      "type": "dart",
      "cwd": "app",
      "program": "lib/main.dart",
      "deviceId": "web-server",
      "args": [ "--web-port", "8080" ]
    },
    {
      "name": "run rails",
      "request": "launch",
      "type": "ruby_lsp",
      "program": "cd api && bin/rails server"
    },
    {
      "name": "flutter test (coverage)",
      "request": "launch",
      "type": "dart",
      "cwd": "app",
      "program": "test",
      "toolArgs": [ "--coverage" ]
    },
    {
      "name": "rspec (coverage)",
      "type": "node-terminal",
      "request": "launch",
      "command": "COVERAGE=1 bundle exec rspec",
      "cwd": "${workspaceFolder}/api"
    }
  ],
  "compounds": [
    {
      "name": "run rails + app",
      "configurations": [ "run rails", "run app" ],
      "stopAll": true
    }
  ]
}
