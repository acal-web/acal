{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "run app",
      "request": "launch",
      "type": "dart",
      "cwd": "app",
      "program": "lib/main.dart",
      "deviceId": "web-server",
      "args": [ "--web-port", "8080" ]
    },
    {
      "name": "run rails",
      "request": "launch",
      "type": "ruby_lsp",
      "program": "cd api && bin/rails server"
    },
    {
      "name": "Maestro: customers tests",
      "type": "node-terminal",
      "request": "launch",
      "command": "xvfb-run --auto-servernum maestro test flows/customers",
      "cwd": "${workspaceFolder}/app/maestro"
    }
  ],
  "compounds": [
    {
      "name": "run rails + app",
      "configurations": [ "run rails", "run app" ],
      "stopAll": true
    }
  ]
}



