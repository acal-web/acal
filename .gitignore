# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Secrets
/.env
*firebase-adminsdk*.json

# Claude Code local settings — personal permission allowlist, accumulates
# command history that can include secrets pasted during debugging.
/.claude/settings.local.json

# OS / editor cruft
.DS_Store
*.swp
.idea/
*.iml
*.ipr
*.iws
.local/
.legacy/

##########################
# api/ (Rails)
##########################

# Ignore bundler config.
/api/.bundle

# Ignore installed gems (BUNDLE_PATH is vendor/bundle for this app).
/api/vendor/bundle

# Ignore all environment files.
/api/.env*

# Ignore all logfiles and tempfiles.
/api/log/*
/api/tmp/*
!/api/log/.keep
!/api/tmp/.keep

# Ignore pidfiles, but keep the directory.
/api/tmp/pids/*
!/api/tmp/pids/
!/api/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/api/storage/*
!/api/storage/.keep
/api/tmp/storage/*
!/api/tmp/storage/
!/api/tmp/storage/.keep

# Ignore key files for decrypting credentials and more.
/api/config/*.key

# SonarCloud coverage report
/api/coverage/

##########################
# app/ (Flutter)
##########################

# Flutter/Dart/Pub related
/app/**/doc/api/
/app/.dart_tool/
/app/.flutter-plugins
/app/.flutter-plugins-dependencies
/app/.pub-cache/
/app/.pub/
/app/build/

# SonarCloud coverage report
/app/coverage/

# Platform build ephemerals (each platform folder also has its own .gitignore)
/app/android/.gradle/
/app/android/app/build/
/app/android/local.properties
/app/ios/Pods/
/app/ios/.symlinks/
/app/macos/Pods/
/app/linux/flutter/ephemeral/
/app/windows/flutter/ephemeral/

##########################
# app/legacy/ (Maven/Java)
##########################
/app/legacy/**/target/

##########################
# .devcontainer/
##########################
/.devcontainer/.env
