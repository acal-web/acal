<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- android:usesCleartextTraffic is intentionally omitted: it is ignored
         whenever a networkSecurityConfig is present, and the actual policy
         (cleartext blocked everywhere except the dev domains below) is
         enforced by @xml/network_security_config instead. -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:fullBackupContent="false"/>
</manifest>
